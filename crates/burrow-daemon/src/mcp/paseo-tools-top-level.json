    {
      "name": "create_workspace",
      "title": "Create workspace",
      "description": "Create a workspace using an existing local checkout or a new Paseo-managed worktree.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "isolation": {
            "type": "string",
            "enum": [
              "local",
              "worktree"
            ]
          },
          "path": {
            "description": "Local directory or source checkout. Defaults to your current workspace. Local isolation adopts an existing directory and never creates one.",
            "type": "string"
          },
          "projectId": {
            "description": "Existing project id to own the workspace.",
            "type": "string"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "background": {
            "description": "True hides the workspace from default lists and the sidebar while its contents remain durable and accessible; omit background to inherit your current workspace\u2019s value (false without a caller), and override it only when the user explicitly asks.",
            "type": "boolean"
          },
          "mode": {
            "description": "Worktree creation mode. Defaults to branch-off.",
            "type": "string",
            "enum": [
              "branch-off",
              "checkout-branch",
              "checkout-pr"
            ]
          },
          "worktreeSlug": {
            "type": "string",
            "minLength": 1
          },
          "branchName": {
            "description": "New branch name for branch-off mode.",
            "type": "string",
            "minLength": 1
          },
          "baseBranch": {
            "description": "Base ref for branch-off mode.",
            "type": "string",
            "minLength": 1
          },
          "branch": {
            "description": "Existing branch for checkout-branch mode.",
            "type": "string",
            "minLength": 1
          },
          "prNumber": {
            "description": "Pull request or change request number for checkout-pr mode.",
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "forge": {
            "description": "Forge for checkout-pr mode. Defaults to the source checkout.",
            "type": "string",
            "minLength": 1
          },
          "serverId": {
            "description": "Destination server ID from list_hosts; omit for this host.",
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "isolation"
        ]
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },

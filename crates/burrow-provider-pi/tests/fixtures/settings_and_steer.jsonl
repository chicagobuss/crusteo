{"dir":"in","frame":{"type":"get_state"}}
{"dir":"out","frame":{"id":"$REQ","type":"response","command":"get_state","success":true,"data":{"model":{"provider":"google","id":"gemini-2.5-flash-lite","input":["text"]},"thinkingLevel":"off","isStreaming":false,"sessionId":"sess-1","messageCount":0,"pendingMessageCount":0}}}
{"cmd":{"thinking":"high"}}
{"dir":"in","frame":{"type":"set_thinking_level","level":"high"}}
{"dir":"out","frame":{"type":"thinking_level_changed","level":"high"}}
{"dir":"out","frame":{"id":"$REQ","type":"response","command":"set_thinking_level","success":true}}
// Not one of pi's levels: Paseo asks for medium.
{"cmd":{"thinking":"ultracode"}}
{"dir":"in","frame":{"type":"set_thinking_level","level":"medium"}}
{"dir":"out","frame":{"id":"$REQ","type":"response","command":"set_thinking_level","success":true}}

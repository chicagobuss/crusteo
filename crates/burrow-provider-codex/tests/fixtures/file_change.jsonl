// A file change approved, a plan update, and a context compaction reported twice.
{"setup":"start"}
{"cmd":{"prompt":{"turn":"codex-turn-1","text":"Write notes.txt"}}}
{"dir":"in","frame":{"method":"turn/start"}}
{"dir":"out","frame":{"id":"$ID","result":{"turn":{"id":"turn-a","status":"inProgress"}}}}
{"dir":"out","frame":{"method":"turn/started","params":{"threadId":"thr-1","turn":{"id":"turn-a","status":"inProgress"}}}}
{"dir":"out","frame":{"method":"turn/plan/updated","params":{"threadId":"thr-1","turnId":"turn-a","explanation":null,"plan":[{"step":"Write the file","status":"inProgress"},{"step":"Check it","status":"pending"}]}}}
{"dir":"out","frame":{"method":"item/started","params":{"threadId":"thr-1","turnId":"turn-a","item":{"type":"fileChange","id":"patch-1","status":"inProgress","changes":[{"path":"/home/user/repo/notes.txt","kind":{"type":"add"},"diff":"hello\n"}]}}}}
{"dir":"out","frame":{"method":"item/fileChange/requestApproval","id":0,"params":{"threadId":"thr-1","turnId":"turn-a","itemId":"patch-1","reason":null,"grantRoot":null,"startedAtMs":1}}}
{"cmd":{"respond":{"id":"0","response":{"behavior":"allow"}}}}
{"dir":"in","frame":{"id":0,"result":{"decision":"accept"}}}
{"dir":"out","frame":{"method":"item/fileChange/outputDelta","params":{"threadId":"thr-1","turnId":"turn-a","itemId":"patch-1","delta":"Success."}}}
{"dir":"out","frame":{"method":"item/completed","params":{"threadId":"thr-1","turnId":"turn-a","item":{"type":"fileChange","id":"patch-1","status":"completed","changes":[{"path":"/home/user/repo/notes.txt","kind":{"type":"add"},"diff":"hello\n"}]}}}}
{"dir":"out","frame":{"method":"item/started","params":{"threadId":"thr-1","turnId":"turn-a","item":{"type":"contextCompaction","id":"cc-1"}}}}
{"dir":"out","frame":{"method":"item/completed","params":{"threadId":"thr-1","turnId":"turn-a","item":{"type":"contextCompaction","id":"cc-1"}}}}
{"dir":"out","frame":{"method":"thread/compacted","params":{"threadId":"thr-1","turnId":"turn-a"}}}
{"dir":"out","frame":{"method":"turn/completed","params":{"threadId":"thr-1","turn":{"id":"turn-a","status":"completed","error":null}}}}
